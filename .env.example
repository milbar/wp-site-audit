# Másold .env néven, és töltsd ki. Az .env fájl UTF-8 legyen (PowerShellben a ">" UTF-16-ot ír, ezért ne azzal hozd létre).

# KÖTELEZŐ: a tartalék admin-belépés jelszava
AUTH_PASS=cserélj-le-egy-erős-jelszóra
#AUTH_USER=admin

# Opcionális: helyi MI (alapból a gemma3:4b; a nagyobb modell ~8 GB RAM-ot kér)
#OLLAMA_MODEL=gemma3:4b
#OLLAMA_SUGGEST_MODEL=gemma3:12b

# Opcionális: böngésző-munkások (legalább 16 véletlen karakter), indítás: docker compose --profile scale up -d --scale worker=3
#WORKER_TOKEN=

# Opcionális: HTTPS reverse proxy mögött
#COOKIE_SECURE=1
#ALLOWED_HOSTS=audit.example.com

# Opcionális: értesítés és külső szolgáltatások
#WEBHOOK_URL=
#WPSCAN_API_TOKEN=
#GOOGLE_API_KEY=
